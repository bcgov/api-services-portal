
namespace SDX {
    entity User;

    entity ConnectionRequest;

    action SubmitConnectionRequest
        appliesTo {
            principal: User,
            resource: ConnectionRequest,
            context: {
                clientId: String,
                serviceId: String,
                environment?: String,
                isApproved: Bool,
                policyVersion: String,
                requesterDetails?: {
                    client: {
                        clientId: String,
                    },
                    requester: String,
                    service: {
                        clientId: String,
                    }
                },
                clientResources?: {
                    gatewayPatterns?: {
                        "sdx-p2p-consumer.r1": {
                            stripPath?: Bool,
                            upgrades?: {
                                sign?: {},
                                verify?: {},
                                counterSign?: {},
                                token?: {
                                    allowedAud: String,
                                    allowedIss: String,
                                    scope?: String,
                                    consumerMatch?: Bool,
                                    consumerMatchClaim?: String,
                                    consumerMatchClaimCustomId?: Bool,
                                    consumerMatchIgnoreNotFound?: Bool
                                },
                                tokenExchange?: {
                                    clientId: String,
                                    tokenEndpoint: String,

                                }
                            }
                        }
                    }
                },
                serviceResources?: {
                    gatewayPatterns?: {
                        "sdx-p2p-provider.r1": {
                            upstreamUrl: String,
                            upgrades: {
                                mtlsAuth?: {},
                                mtlsAcl?: {},
                                sign?: {},
                                verify?: {},
                                counterSign?: {},
                                token?: {
                                    allowedAud: String,
                                    allowedIss: String,
                                    scope?: String,
                                    consumerMatch?: Bool,
                                    consumerMatchClaim?: String,
                                    consumerMatchClaimCustomId?: Bool,
                                    consumerMatchIgnoreNotFound?: Bool
                                },
                                tokenExchange?: {
                                    clientId: String,
                                    tokenEndpoint: String,
                                }
                            }
                        }
                    }
                },
                combinedScopes: Set<String>,
                globals: {
                    environment: {
                        client_id: String,
                        oauth_token_url: String
                    }
                }
            },
        };

    entity ConsumerPattern;

    action ApplyConsumerPattern
        appliesTo {
            principal: User,
            resource: ConsumerPattern,
            context: {
                conn_id: String,
                client_id: String,
                service_id: String,
                tls_verify?: Bool,
                upgrades?: {
                    sign?: {},
                    verify?: {},
                    counter_sign?: {},
                    token?: {
                        allowed_aud: String,
                        allowed_iss: String,
                        scope?: String,
                        consumer_match?: Bool,
                        consumer_match_claim?: String,
                        consumer_match_claim_custom_id?: Bool,
                        consumer_match_ignore_not_found?: Bool
                    },
                    token_exchange?: {
                        client_id: String,
                        token_endpoint: String,

                    }
                }
            }
        };

    entity ProviderPattern;

    action ApplyProviderPattern
        appliesTo {
            principal: User,
            resource: ProviderPattern,
            context: {
                conn_id: String,
                client_id: String,
                service_id: String,
                upgrades?: {
                    sign?: {},
                    verify?: {},
                    token?: {
                        allowed_aud: String,
                        allowed_iss: String,
                        scope?: String,
                        consumer_match?: Bool,
                        consumer_match_claim?: String,
                        consumer_match_claim_custom_id?: Bool,
                        consumer_match_ignore_not_found?: Bool
                    },
                    dpop?: {}
                }
            }
        };
}
