{
  "name": "provisioner-api",
  "version": "0.1.0",
  "private": true,
  "description": "Provisioner API — gateway configuration automation for SDX and APS resources.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "spec": "tsx src/print-spec.ts",
    "spec:yaml": "tsx src/print-spec.ts --yaml --out openapi.yaml",
    "spec:json": "tsx src/print-spec.ts --out openapi.json",
    "lint:spec": "npm run --silent spec:yaml && spectral lint --ruleset ../.spectral.yaml --fail-severity=warn openapi.yaml",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "^4.11.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@scalar/fastify-api-reference": "^1.57.5",
    "@sinclair/typebox": "^0.34.9",
    "fastify": "^5.2.0",
    "jose": "^6.2.3",
    "js-yaml": "^4.1.1",
    "oauth4webapi": "^3.8.6"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "^6.11.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}