# Upstream client configuration
# Each prefix (APS, SDX, GWA, CSS) is independent — a missing prefix leaves
# that client in "unconfigured" mode (any call throws a descriptive error).

# --- APS (signed JWT / private_key_jwt, key in JWK JSON file) ---
APS_BASE_URL=https://aps.example.gov.bc.ca/ds/api
APS_TOKEN_URL=https://oidc.example.gov.bc.ca/token
APS_CLIENT_ID=aps-partner
APS_JWK_PATH=./secrets/aps.jwk.json
# Optional:
# APS_KEY_ALG=RS256               # defaults to the JWK's "alg", then RS256
# APS_KID=aps-2026-01             # defaults to the JWK's "kid"
# APS_SCOPE=Namespace.Manage
# APS_AUDIENCE=https://aps.example.gov.bc.ca

# --- FEED ---
FEED_URL=https://feed.example.gov.bc.ca/api

# --- SDX (signed JWT / private_key_jwt, key in JWK JSON file) ---
SDX_BASE_URL=https://sdx.example.gov.bc.ca
SDX_TOKEN_URL=https://oidc.example.gov.bc.ca/token
SDX_CLIENT_ID=sdx-partner
SDX_JWK_PATH=./secrets/sdx.jwk.json

# --- GWA (signed JWT / private_key_jwt, key in JWK JSON file) ---
# GWA is configured per environment (dev/test/prod/…). Each environment in the
# environments config (ENVIRONMENTS_CONFIG_FILE) supplies its own GWA API
# endpoint (`gwa_api_url`), OAuth token endpoint (`oauth_token_url`), and OAuth
# client id (`client_id`). The variables below provide the shared signing key
# and JWT parameters used for every environment; GWA_CLIENT_ID is only a
# fallback for environments that omit `client_id`.
GWA_JWK_PATH=./secrets/gwa.jwk.json
# Optional:
# GWA_CLIENT_ID=gwa-partner        # fallback when an environment omits client_id
# GWA_KEY_ALG=RS256                # defaults to the JWK's "alg", then RS256
# GWA_KID=gwa-2026-01              # defaults to the JWK's "kid"
# GWA_SCOPE=Namespace.Manage
# GWA_AUDIENCE=https://gwa.example.gov.bc.ca

# --- CSS (client_id + client_secret) ---
CSS_BASE_URL=https://css.example.gov.bc.ca/api/v1
CSS_TOKEN_URL=https://css-oidc.example.gov.bc.ca/realms/standard/protocol/openid-connect/token
CSS_CLIENT_ID=css-app
CSS_CLIENT_SECRET=changeme

# --- Development-only ---
# Permit non-HTTPS (http://) OAuth token endpoints. Ignored when
# NODE_ENV=production. Use only against local/non-TLS auth servers.
# OAUTH_ALLOW_INSECURE_REQUESTS=true

SDX_OPERATOR_CONSUMER_URL=http://kong-sdx-edge0.localtest.me:9080
# The SDX Operator edge server used for CSR generation is configured per
# environment via `operator_edge_url` in the environments config
# (ENVIRONMENTS_CONFIG_FILE), so the correct edge endpoint is called for each
# environment (dev/test/prod/…).
