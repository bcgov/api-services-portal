APS_TOKEN_URL=http://keycloak.localtest.me:9081/auth/realms/master/protocol/openid-connect/token
APS_CLIENT_ID=sdx-provisioner
APS_JWK_PATH=/secrets/key.json

# --- SDX (signed JWT / private_key_jwt, key in JKS keystore) ---
SDX_BASE_URL=http://oauth2proxy.localtest.me:4180/ds/api/sdx/v1
SDX_TOKEN_URL=http://keycloak.localtest.me:9081/auth/realms/master/protocol/openid-connect/token
SDX_CLIENT_ID=sdx-provisioner
SDX_JWK_PATH=/secrets/key.json

# --- GWA (signed JWT / private_key_jwt, key in JKS keystore) ---
GWA_BASE_URL=http://gwa-api.localtest.me:2000/v2
GWA_TOKEN_URL=http://keycloak.localtest.me:9081/auth/realms/master/protocol/openid-connect/token
GWA_CLIENT_ID=sdx-provisioner
GWA_JWK_PATH=/secrets/key.json

