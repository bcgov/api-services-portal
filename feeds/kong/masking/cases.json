{
  "mask": "****",
  "cases": [
    {
      "name": "Kong 3.x rate-limiting: nested redis object and legacy flat redis_* fields",
      "kind": "plugin",
      "input": {
        "name": "rate-limiting",
        "config": {
          "minute": 100,
          "policy": "redis",
          "redis_host": "redis.platform.internal",
          "redis_port": 6379,
          "redis_password": "platform-password",
          "redis_username": "platform-user",
          "redis_ssl": false,
          "redis": {
            "host": "redis.platform.internal",
            "port": 6379,
            "password": "platform-password",
            "username": "platform-user",
            "database": 0,
            "ssl": false,
            "timeout": 2000
          }
        }
      },
      "expected": {
        "name": "rate-limiting",
        "config": {
          "minute": 100,
          "policy": "redis",
          "redis_host": "****",
          "redis_port": 6379,
          "redis_password": "****",
          "redis_username": "****",
          "redis_ssl": false,
          "redis": {
            "host": "****",
            "port": 6379,
            "password": "****",
            "username": "****",
            "database": 0,
            "ssl": false,
            "timeout": 2000
          }
        }
      }
    },
