    {
      "name": "PEM private keys and bearer tokens in code; certificates kept",
      "kind": "plugin",
      "input": {
        "name": "pre-function",
        "config": {
          "access": [
            "local key = [[-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA\nabc\n-----END RSA PRIVATE KEY-----]]",
            "kong.service.request.set_header(\"Authorization\", \"Bearer eyJhbGciOi.payload.sig\")"
          ],
          "some_cert": "-----BEGIN CERTIFICATE-----\nMIIB\n-----END CERTIFICATE-----"
        }
      },
      "expected": {
        "name": "pre-function",
        "config": {
          "access": [
            "local key = ****",
            "kong.service.request.set_header(\"Authorization\", \"****\")"
          ],
          "some_cert": "-----BEGIN CERTIFICATE-----\nMIIB\n-----END CERTIFICATE-----"
        }
      }
