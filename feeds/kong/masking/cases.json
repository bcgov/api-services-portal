    {
      "name": "transformer Name:value lists",
      "kind": "plugin",
      "input": {
        "name": "request-transformer",
        "config": {
          "add": {
            "headers": [
              "Authorization:Bearer abc.def",
              "X-API-Key:k3",
              "X-Request-Source:portal"
            ],
            "querystring": ["api_key:k4", "format:json"],
            "body": ["client_secret:s7", "grant_type:client_credentials"]
          },
          "replace": {
            "headers": ["x-auth-token: t3"],
            "querystring": [],
            "body": []
          },
          "append": {
            "headers": ["Cookie:session=abc"]
          },
          "remove": {
            "headers": ["Authorization"]
          },
          "rename": {
            "headers": ["X-Old:X-New"]
          }
        }
      },
      "expected": {
        "name": "request-transformer",
        "config": {
          "add": {
            "headers": [
              "Authorization:****",
              "X-API-Key:****",
              "X-Request-Source:portal"
            ],
            "querystring": ["api_key:****", "format:json"],
            "body": ["client_secret:****", "grant_type:client_credentials"]
          },
          "replace": {
            "headers": ["x-auth-token:****"],
            "querystring": [],
            "body": []
          },
          "append": {
            "headers": ["Cookie:****"]
          },
          "remove": {
            "headers": ["Authorization"]
          },
          "rename": {
            "headers": ["X-Old:X-New"]
          }
        }
      }
    },
